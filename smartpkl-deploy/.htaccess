<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # -------------------------------------------------------
    # Rule 1: API Routes → Laravel (index.php)
    # -------------------------------------------------------
    RewriteCond %{REQUEST_URI} ^/api/
    RewriteRule ^ index.php [L]

    # -------------------------------------------------------
    # Rule 2: Sanctum CSRF Cookie → Laravel
    # -------------------------------------------------------
    RewriteCond %{REQUEST_URI} ^/sanctum/
    RewriteRule ^ index.php [L]

    # -------------------------------------------------------
    # Rule 3: Existing static files → serve directly
    # (React assets, images, favicon, robots.txt, etc.)
    # -------------------------------------------------------
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # -------------------------------------------------------
    # Rule 4: Everything else → React SPA (app.html)
    # This handles client-side routes like /login, /student/dashboard, etc.
    # -------------------------------------------------------
    RewriteRule ^ app.html [L]
</IfModule>

# ===========================================================
# Fallback: If mod_rewrite is not available
# ===========================================================
<IfModule !mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>
</IfModule>
